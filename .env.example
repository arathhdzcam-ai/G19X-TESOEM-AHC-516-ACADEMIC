# Secreto JWT local: reemplazar en el archivo .env
SUPPLYCHAIN_JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_LOCAL_DE_AL_MENOS_32_CARACTERES

# Endpoint de Azure AI: incluir la ruta /openai/v1
AZURE_OPENAI_ENDPOINT=https://tu-recurso.services.ai.azure.com/openai/v1

# Nombre del despliegue de Azure OpenAI
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
